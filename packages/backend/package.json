{
  "name": "@slidex/backend",
  "private": true,
  "version": "0.1.0",
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./data-model": {
      "types": "./convex/_generated/dataModel.d.ts"
    }
  },
  "scripts": {
    "dev": "convex dev",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "typecheck": "tsc --project convex/tsconfig.json --noEmit",
    "test": "vitest run",
    "deploy:demo": "static-hosting upload --dist ../../apps/web/out --build-command \"pnpm --filter=slidex-web build\"",
    "deploy": "static-hosting deploy --dist ../../apps/web/out --build-command \"pnpm --filter=slidex-web build\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.66",
    "@auth/core": "0.41.1",
    "@convex-dev/agent": "^0.7.2",
    "@convex-dev/ai-sdk-provider": "^0.1.0",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/static-hosting": "^0.2.1",
    "ai": "^7.0.0",
    "convex": "^1.45.0",
    "svix": "^2.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.0.0",
    "convex-test": "^0.0.58",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "type": "module"
}
