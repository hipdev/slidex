{
  "name": "@slidex/backend",
  "private": true,
  "version": "0.1.0",
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./data-model": {
      "types": "./convex/_generated/dataModel.d.ts"
    }
  },
  "scripts": {
    "dev": "convex dev",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "typecheck": "tsc --project convex/tsconfig.json --noEmit",
    "test": "vitest run",
    "deploy:demo": "static-hosting upload --dist ../../apps/web/out --build-command \"pnpm --filter=slidex-web build\"",
    "deploy": "static-hosting deploy --dist ../../apps/web/out --build-command \"pnpm --filter=slidex-web build\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.121",
    "@convex-dev/agent": "^0.7.10",
    "@convex-dev/ai-sdk-provider": "^0.3.0",
    "@convex-dev/auth": "2.0.0",
    "@convex-dev/rate-limiter": "^0.4.3",
    "@convex-dev/resend": "0.2.10",
    "@convex-dev/static-hosting": "^0.2.2",
    "ai": "^7.0.176",
    "convex": "^1.50.0",
    "svix": "^2.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.6.6",
    "convex-test": "^0.0.72",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
